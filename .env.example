# LLM（可选：不填也能跑，会自动回退到规则抽取）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=90

# OSM 证据源（可选：连不上会自动降级为"未核实"，不会让程序崩溃）
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT=25
OSM_ENABLED=1
OSM_RADIUS_M=150

# 缓存目录（避免重复查询 Overpass）
ROUTE_GUARD_CACHE=.cache
